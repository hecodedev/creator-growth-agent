{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-growth-agent.local/schemas/standard-output.schema.json",
  "title": "StandardWorkflowOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "objective",
    "verified_findings",
    "evidence_sources",
    "recommendation",
    "next_actions",
    "confidence_and_missing_info"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "pattern": "^[0-9]{2}-"
    },
    "synthetic": { "type": "boolean" },
    "output_language": { "type": "string" },
    "objective": { "type": "string", "minLength": 1 },
    "verified_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source", "date"],
        "properties": {
          "claim": { "type": "string" },
          "source": { "type": "string" },
          "date": { "type": ["string", "null"] },
          "kind": {
            "type": "string",
            "enum": ["evidence", "inference", "unknown"]
          }
        }
      }
    },
    "recommendation": { "type": "string" },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence_and_missing_info": { "type": "string" }
  }
}
