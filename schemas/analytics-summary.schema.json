{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creator-growth-agent.local/schemas/analytics-summary.schema.json",
  "title": "AnalyticsSummary",
  "type": "object",
  "required": ["synthetic", "period", "rows", "contains_credentials"],
  "properties": {
    "synthetic": { "type": "boolean" },
    "period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "target", "result"],
        "properties": {
          "metric": { "type": "string" },
          "target": {},
          "result": {},
          "source": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "contains_credentials": { "const": false },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  }
}
